# Copiar a `.env` y completar (no commitear `.env`).
# Pooler: runtime Next.js / PrismaClient (`src/lib/prisma.ts`).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Conexión directa: CLI Prisma migraciones (`prisma.config.ts` usa DIRECT_URL si existe).
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Sesión (producción obligatorio) ---
SESSION_SECRET="cambia-por-32-bytes-aleatorios-en-prod-OK"

# --- Link público del Conductor (`/conductor/{token}`, sin login) ---
# 32–128 caracteres [A-Za-z0-9_-]. Vacío = link deshabilitado. Cambiarlo invalida el link anterior.
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ENVIOS_CONDUCTOR_TOKEN=""

# --- IDs heredados de DUX (no hay consultas a la API DUX) ---
# IDs depósito Maipú / Guaymallén (default 16923 / 4565), usados por `prodTiendaStock.service`.
# Cada sucursal es depósito local; el ledger es `stock_movimientos` (no hay `stock_depositos`).
DUX_ID_STOCK_MAIPU="16923"
DUX_ID_STOCK_GUAYMALLEN="4565"

# --- Otros ---
# Deprecado en runtime: cotización USD vive en `cotizacion_usd` (ver BACKEND_GUIDELINES §3.2).
# Solo seed/fallback si la tabla está vacía al primer acceso.
COTIZACION_DOLAR="1"

# --- ARCA / AFIP (WSAA + WSFEv1 + Constancia de Inscripción). Homologación por defecto. No commitear PEM. ---
# homo | prod  (default homo si vacío). Facturación electrónica.
ARCA_ENV="homo"
# homo | prod. Solo la consulta de CUIT de 20372672235. Si falta, usa ARCA_ENV.
# No es ARCA_ENV y no mueve la facturación.
ARCA_CONSTANCIA_ENV_20372672235="homo"
# Timeout SOAP ms (default 30000).
ARCA_TIMEOUT_MS="30000"
# Tope ImpTotal para Consumidor Final sin identificar (DocTipo 99 / DocNro 0).
ARCA_CF_MAX_SIN_DOC="10000000"
# Un par por CUIT emisor (no por punto de venta). Varios pto. vta. del mismo CUIT
# usan el mismo par. Constancia de Inscripción: el CUIT del cliente no lleva PEM.
# La consulta de cliente siempre autentica con 20-37267223-5 (override opcional):
# ARCA_CONSTANCIA_CUIT="20372672235"
# En Vercel: Production y Preview. No reabrir y guardar vacío.
# Constancia (DN TiedaColorC1). Obligatorio en Vercel Production y Preview (no alcanza el par de facturación).
# Tras cambiar PEM: local → reiniciar npm run dev; Vercel → Redeploy.
# Par de constancia del CUIT 20372672235. Distinto de ARCA_CERT_PEM_20372672235 (facturación).
ARCA_CONSTANCIA_CERT_PEM_20372672235=""
ARCA_CONSTANCIA_KEY_PEM_20372672235=""
# El certificado de ese CUIT debe tener en ARCA los WS en el **mismo DN** (CN) del PEM:
#   constancia: ws_sr_constancia_inscripcion
#   facturación: wsfe
# ARCA_ENV=homo con certificado de producción (o al revés) = rechazo.
ARCA_CERT_PEM_20372672235=""
ARCA_KEY_PEM_20372672235=""
ARCA_KEY_PASSPHRASE_20372672235=""
ARCA_CERT_PEM_23169084289=""
ARCA_KEY_PEM_23169084289=""
ARCA_CERT_PEM_20329808824=""
ARCA_KEY_PEM_20329808824=""
# Fallback de un solo emisor (si no hay variables con CUIT).
# ARCA_CERT_PEM=""
# ARCA_KEY_PEM=""
# ARCA_CUIT=""

